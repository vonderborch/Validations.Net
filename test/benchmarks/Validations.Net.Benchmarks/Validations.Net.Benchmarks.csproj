<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AssemblyName>Validations.Net.Benchmarks</AssemblyName>
        <RootNamespace>Validations.Net.Benchmarks</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>..\..\..\debug\tests\benchmarks\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>..\..\..\release\tests\benchmarks\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\source\Validations.Net\Validations.Net.csproj" />
    </ItemGroup>

</Project>
