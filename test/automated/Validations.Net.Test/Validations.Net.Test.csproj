<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <AssemblyName>Validations.Net.Test</AssemblyName>
        <RootNamespace>Validations.Net.Test</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <ApplicationIcon>..\..\..\logo.ico</ApplicationIcon>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>..\..\..\debug\tests\automated\core\</OutputPath>
        <DefineConstants>TRACE;Core</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>..\..\..\release\tests\automated\core\</OutputPath>
        <DefineConstants>TRACE;Core</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="NUnit" Version="4.2.2"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.3.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0"/>
    </ItemGroup>

    <ItemGroup>
      <Using Include="NUnit.Framework"/>
      <Using Include="Validations.Net"/>
      <Using Include="Validations.Net.Validators"/>
      <Using Include="Validations.Net.Validators.Age"/>
      <Using Include="Validations.Net.Validators.DateTime"/>
      <Using Include="Validations.Net.Validators.DataFormat"/>
      <Using Include="Validations.Net.ValidationAttributes"/>
      <Using Include="Validations.Net.ValidationAttributes.Age"/>
      <Using Include="Validations.Net.ValidationAttributes.DataFormat"/>
      <Using Include="Validations.Net.ValidationAttributes.DateTime"/>
      <Using Include="Validations.Net.ValidationAttributes.FileSystem"/>
      <Using Include="Validations.Net.ValidationAttributes.Finance"/>
      <Using Include="Validations.Net.ValidationAttributes.Geography"/>
      <Using Include="Validations.Net.ValidationAttributes.Identifiers"/>
      <Using Include="Validations.Net.ValidationAttributes.Network"/>
      <Using Include="Validations.Net.ValidationAttributes.Phone"/>
      <Using Include="Validations.Net.ValidationAttributes.Security"/>
      <Using Include="Validations.Net.ValidationAttributes.Streams"/>
      <Using Include="Validations.Net.ValidationAttributes.Version"/>
      <Using Include="Validations.Net.ValidationSets"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\source\Validations.Net\Validations.Net.csproj" />
    </ItemGroup>


</Project>
